<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_setting"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Thanh kéo -->
        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_handle" />

        <!-- Tiêu đề -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Thiết lập tài khoản"
                android:textColor="#262722"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseAccountSettings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_close_button"
                android:gravity="center"
                android:text="×"
                android:textColor="#222222"
                android:textSize="28sp" />
        </RelativeLayout>

        <!-- Ảnh đại diện -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgAccountPhoto"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_avatar"
                android:contentDescription="Ảnh đại diện tài khoản"
                android:padding="20dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera" />

            <TextView
                android:id="@+id/btnChoosePhoto"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Đổi ảnh đại diện"
                android:textColor="@color/violet_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tên hiển thị -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tên hiển thị"
            android:textColor="#292A27"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtAccountName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_profile_text_input"
            android:hint="Nhập tên của bạn"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#292A27"
            android:textColorHint="#999999"
            android:textSize="15sp" />

        <!-- Tên tài khoản -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Tên tài khoản"
            android:textColor="#292A27"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtAccountUsername"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_profile_text_input"
            android:hint="\u0040username"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#292A27"
            android:textColorHint="#999999"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Tiểu sử"
            android:textColor="#292A27"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtAccountBio"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_profile_text_input"
            android:gravity="top|start"
            android:hint="Viết vài dòng về bạn"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="160"
            android:maxLines="4"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="#292A27"
            android:textColorHint="#999999"
            android:textSize="15sp" />


        <!-- Lưu thay đổi -->
        <TextView
            android:id="@+id/btnSaveAccountSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="#6261CF"
            android:gravity="center"
            android:text="Lưu thay đổi"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
