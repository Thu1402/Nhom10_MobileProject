<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_setting"
    android:paddingStart="28dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Thanh kéo -->
    <View
        android:layout_width="64dp"
        android:layout_height="8dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle" />

    <!-- Tiêu đề -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Thiết lập tài khoản"
            android:textColor="#262722"
            android:textSize="27sp" />

        <TextView
            android:id="@+id/btnCloseSettings"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_close_button"
            android:gravity="center"
            android:text="×"
            android:textColor="#222222"
            android:textSize="34sp" />
    </RelativeLayout>

    <!-- Thông tin cá nhân -->
    <LinearLayout
        android:id="@+id/rowPersonal"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_icon_tile"
            android:gravity="center"
            android:text="♙"
            android:textColor="#6554E8"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông tin cá nhân"
                android:textColor="#292A27"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tên, ảnh đại diện, vị trí"
                android:textColor="#85867D"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#262722"
            android:textSize="34sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E6E5DC" />

    <!-- Thông báo -->
    <LinearLayout
        android:id="@+id/rowNotifications"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_icon_tile"
            android:gravity="center"
            android:text="♧"
            android:textColor="#6554E8"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thông báo"
                android:textColor="#292A27"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Lời mời và hoạt động bạn bè"
                android:textColor="#85867D"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#262722"
            android:textSize="34sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E6E5DC" />

    <!-- Quyền riêng tư -->
    <LinearLayout
        android:id="@+id/rowPrivacy"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_icon_tile"
            android:gravity="center"
            android:text="♢"
            android:textColor="#6554E8"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quyền riêng tư"
                android:textColor="#292A27"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Kiểm soát dữ liệu của bạn"
                android:textColor="#85867D"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#262722"
            android:textSize="34sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:background="#E6E5DC" />

    <!-- Đăng xuất -->
    <TextView
        android:id="@+id/rowLogout"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center_vertical"
        android:text="⇥    Đăng xuất"
        android:textColor="#292A27"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Xóa tài khoản -->
    <TextView
        android:id="@+id/rowDelete"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:text="♜    Xóa tài khoản"
        android:textColor="#D45158"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>