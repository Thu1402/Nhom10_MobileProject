<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF0E5">

    <WebView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#EEF0E5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/btnMapBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_edit_button"
        android:clickable="true"
        android:contentDescription="Quay lại"
        android:elevation="12dp"
        android:focusable="true"
        android:gravity="center"
        android:text="&lt;"
        android:textColor="#171717"
        android:textSize="36sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_edit_button"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toTopOf="@id/btnMapBack"
        app:layout_constraintBottom_toBottomOf="@id/btnMapBack"
        app:layout_constraintStart_toEndOf="@id/btnMapBack"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="⌕"
            android:textColor="#858585"
            android:textSize="30sp" />
        <EditText
            android:id="@+id/etMapSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Tìm địa điểm hoặc địa chỉ"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:paddingStart="10dp"
            android:textColor="#292929"
            android:textColorHint="#999999"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/categoryButton"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edit_button"
        android:contentDescription="Vị trí của tôi"
        android:elevation="8dp"
        android:gravity="center"
        android:text="◎"
        android:textColor="@color/violet_dark"
        android:textSize="27sp"
        app:layout_constraintBottom_toTopOf="@id/btnAddPlaceAtLocation"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/searchSuggestions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_setting"
        android:elevation="18dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/searchSuggestionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/zoomControls"
        android:layout_width="58dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="14dp"
        android:elevation="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/placeBottomSheet"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/btnZoomIn"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_edit_button"
            android:contentDescription="Phóng to bản đồ"
            android:gravity="center"
            android:text="＋"
            android:textColor="@color/violet_dark"
            android:textSize="34sp"
            android:textStyle="normal" />
        <TextView
            android:id="@+id/btnZoomOut"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edit_button"
            android:contentDescription="Thu nhỏ bản đồ"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/violet_dark"
            android:textSize="34sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/placeBottomSheet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_setting"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <FrameLayout
            android:id="@+id/sheetDragHandle"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_handle" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvPlaceCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Địa điểm đã lưu"
                android:textColor="#292929"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/routeButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_close_button"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Chỉ đường ↗"
                android:textColor="@color/violet_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/placeCard"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_edit_button"
            android:clipToOutline="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ivPlacePhoto"
                android:layout_width="108dp"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh địa điểm"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_empty_place_photo" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">
                <TextView
                    android:id="@+id/tvPlaceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
            android:text="Chưa có địa điểm"
                    android:textColor="#292929"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvPlaceAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxLines="2"
                    android:text="Chạm bản đồ để thêm địa điểm"
                    android:textColor="#858585"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tvPlaceDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text=""
                    android:textColor="@color/violet_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Gần bạn"
            android:textColor="#292929"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvNearbyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:text="Bật định vị để xem địa điểm quanh bạn"
            android:textColor="#777B73"
            android:textSize="11sp" />
        <HorizontalScrollView
            android:id="@+id/nearbyScroll"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="5dp"
            android:fillViewport="false"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/nearbyList"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/btnAddPlaceAtLocation"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_close_button"
        android:backgroundTint="@color/lime"
        android:clickable="true"
        android:elevation="20dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="＋  Thêm địa điểm"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/placeBottomSheet"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
